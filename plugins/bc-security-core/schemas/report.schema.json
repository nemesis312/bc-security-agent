{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nemesis312/bc-security-agent/schemas/report.schema.json",
  "title": "bc-security report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "language", "scan", "summary", "findings"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "bc-security" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "base", "generated_at", "files_reviewed", "domains_used", "domains_missing"],
      "properties": {
        "mode": { "enum": ["changes", "branch", "full"] },
        "base": { "type": ["string", "null"] },
        "generated_at": { "type": "string", "format": "date-time" },
        "files_reviewed": { "type": "array", "items": { "type": "string" } },
        "domains_used": {
          "type": "array",
          "items": { "enum": ["code", "secrets", "infra", "ai", "general"] }
        },
        "domains_missing": {
          "type": "array",
          "items": { "enum": ["code", "secrets", "infra", "ai"] }
        }
      }
    },
    "summary": {
      "description": "Counting rule: each finding is counted exactly once. Findings with confidence \"low\" are counted only in to_verify and are NOT included in the critical/high/medium/low/info counts; all other findings are counted by severity.",
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "medium", "low", "info", "to_verify"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "to_verify": { "description": "Number of findings with confidence \"low\"; these are excluded from the severity counts.", "type": "integer", "minimum": 0 }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "rule_id", "title", "domain", "severity", "cvss", "confidence",
        "standards", "location", "evidence", "impact", "remediation"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rule_id": {
          "type": "string",
          "pattern": "^(BCS-(CODE|SEC|INFRA|AI)-\\d{3}|BCS-GEN-000)$"
        },
        "title": { "type": "string", "minLength": 1 },
        "domain": { "enum": ["code", "secrets", "infra", "ai", "general"] },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "cvss": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "score", "vector"],
          "properties": {
            "version": { "const": "3.1" },
            "score": { "type": "number", "minimum": 0, "maximum": 10 },
            "vector": { "type": "string", "pattern": "^CVSS:3\\.1/.+" }
          }
        },
        "confidence": { "enum": ["high", "medium", "low"] },
        "standards": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cwe"],
          "properties": {
            "owasp_top10": { "type": "string", "minLength": 1 },
            "owasp_llm": { "type": "string", "minLength": 1 },
            "cwe": {
              "type": "array",
              "items": { "type": "string", "pattern": "^CWE-\\d+$" }
            },
            "asvs": { "type": "string", "minLength": 1 }
          }
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "line_start", "line_end"],
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "line_start": { "type": "integer", "minimum": 1 },
            "line_end": { "type": "integer", "minimum": 1 }
          }
        },
        "evidence": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
